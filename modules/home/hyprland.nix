# Hyprland: the fallback session, kept small on purpose. Waybar, a launcher
# (fuzzel), notifications (mako), a lock screen (hyprlock), the wallpaper
# (swaybg), a polkit agent and the network and Bluetooth tray applets.
#
# Hyprland 0.55 reads ~/.config/hypr/hyprland.lua (the old hyprland.conf
# format is deprecated). The file is checked with `Hyprland --verify-config`
# when the system is built.
{
  config,
  lib,
  pkgs,
  osConfig,
  ...
}:
let
  desktop = osConfig.my.desktop;
  theme = osConfig.my.theme;
  p = theme.palette;
  accent = p.${theme.accent};
  font = theme.fonts.sans.name;

  # "#cba6f7" -> "cba6f7"
  bare = lib.removePrefix "#";
  # A Nix string as a Lua string literal (JSON string escapes are valid Lua).
  lua = builtins.toJSON;

  hyprland = osConfig.programs.hyprland.package;
  exe = lib.getExe;
  wpctl = lib.getExe' osConfig.services.pipewire.wireplumber.package "wpctl";
  wlCopy = lib.getExe' pkgs.wl-clipboard "wl-copy";

  terminal = exe pkgs.foot;
  launcher = exe pkgs.fuzzel;
  fileManager = "${exe pkgs.nautilus} --new-window";
  lock = exe pkgs.hyprlock;
  screenshotArea = "${exe pkgs.grim} -g \"$(${exe pkgs.slurp})\" - | ${wlCopy}";
  screenshotScreen = "${exe pkgs.grim} - | ${wlCopy}";

  # Started once when Hyprland starts. These are absolute store paths on
  # purpose: none of them is a systemd service or D-Bus activated, so they
  # cannot leak into the niri session.
  autostart = [
    (exe config.programs.waybar.package)
    (exe pkgs.mako)
    "${exe pkgs.swaybg} --mode fill --image ${theme.wallpaper}"
    "${pkgs.hyprpolkitagent}/libexec/hyprpolkitagent"
    "${lib.getExe' pkgs.networkmanagerapplet "nm-applet"} --indicator"
    (lib.getExe' pkgs.blueman "blueman-applet")
  ];

  luaConfig = ''
    -- Generated by modules/home/hyprland.nix. Change that file, not this one.

    local mod = "SUPER"

    -- Monitors: detected automatically, each in its preferred mode.
    hl.monitor({ output = "", mode = "preferred", position = "auto", scale = "auto" })

    hl.env("XCURSOR_THEME", ${lua theme.cursor.name})
    hl.env("XCURSOR_SIZE", ${lua (toString theme.cursor.size)})
    ${lib.optionalString (desktop.hyprland.drmDevices != null) ''
      -- GPU order for Hyprland (my.desktop.hyprland.drmDevices).
      hl.env("AQ_DRM_DEVICES", ${lua desktop.hyprland.drmDevices})
    ''}
    hl.on("hyprland.start", function()
    ${lib.concatMapStrings (cmd: "  hl.exec_cmd(${lua cmd})\n") autostart}end)

    hl.config({
        general = {
            gaps_in = 5,
            gaps_out = 10,
            border_size = 2,
            col = {
                active_border = ${lua "rgb(${bare accent})"},
                inactive_border = ${lua "rgb(${bare p.surface1})"},
            },
            layout = "dwindle",
        },
        decoration = {
            rounding = 8,
        },
        input = {
            kb_layout = ${lua osConfig.my.locale.keyboardLayout},
            numlock_by_default = true,
            follow_mouse = 1,
            -- No mouse acceleration: pointer speed follows the mouse 1:1.
            accel_profile = "flat",
        },
        misc = {
            force_default_wallpaper = 0,
            disable_hyprland_logo = true,
        },
        ecosystem = {
            no_update_news = true,
            no_donation_nag = true,
        },
        dwindle = {
            preserve_split = true,
        },
    })
    -- Programs
    hl.bind(mod .. " + T", hl.dsp.exec_cmd(${lua terminal}))
    hl.bind(mod .. " + RETURN", hl.dsp.exec_cmd(${lua terminal}))
    hl.bind(mod .. " + D", hl.dsp.exec_cmd(${lua launcher}))
    hl.bind(mod .. " + SPACE", hl.dsp.exec_cmd(${lua launcher}))
    hl.bind(mod .. " + E", hl.dsp.exec_cmd(${lua fileManager}))
    hl.bind("SUPER + ALT + L", hl.dsp.exec_cmd(${lua lock}))
    hl.bind("Print", hl.dsp.exec_cmd(${lua screenshotArea}))
    hl.bind("SHIFT + Print", hl.dsp.exec_cmd(${lua screenshotScreen}))

    -- Windows
    hl.bind(mod .. " + Q", hl.dsp.window.close())
    hl.bind(mod .. " + V", hl.dsp.window.float({ action = "toggle" }))
    hl.bind(mod .. " + F", hl.dsp.window.fullscreen({ mode = "maximized" }))
    hl.bind(mod .. " + SHIFT + F", hl.dsp.window.fullscreen())
    hl.bind(mod .. " + mouse:272", hl.dsp.window.drag(), { mouse = true })
    hl.bind(mod .. " + mouse:273", hl.dsp.window.resize(), { mouse = true })
    hl.bind(mod .. " + SHIFT + E", hl.dsp.exit())

    local directions = { left = "left", right = "right", up = "up", down = "down", H = "left", L = "right", K = "up", J = "down" }
    for key, direction in pairs(directions) do
        hl.bind(mod .. " + " .. key, hl.dsp.focus({ direction = direction }))
        hl.bind(mod .. " + SHIFT + " .. key, hl.dsp.window.move({ direction = direction }))
    end

    -- Workspaces 1 to 10 (key 0 is workspace 10)
    for i = 1, 10 do
        local key = i % 10
        hl.bind(mod .. " + " .. key, hl.dsp.focus({ workspace = i }))
        hl.bind(mod .. " + SHIFT + " .. key, hl.dsp.window.move({ workspace = i }))
    end
    hl.bind(mod .. " + mouse_down", hl.dsp.focus({ workspace = "e+1" }))
    hl.bind(mod .. " + mouse_up", hl.dsp.focus({ workspace = "e-1" }))

    -- Volume and media keys, also on the lock screen
    hl.bind("XF86AudioRaiseVolume", hl.dsp.exec_cmd(${lua "${wpctl} set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"}), { locked = true, repeating = true })
    hl.bind("XF86AudioLowerVolume", hl.dsp.exec_cmd(${lua "${wpctl} set-volume @DEFAULT_AUDIO_SINK@ 5%-"}), { locked = true, repeating = true })
    hl.bind("XF86AudioMute", hl.dsp.exec_cmd(${lua "${wpctl} set-mute @DEFAULT_AUDIO_SINK@ toggle"}), { locked = true })
    hl.bind("XF86AudioMicMute", hl.dsp.exec_cmd(${lua "${wpctl} set-mute @DEFAULT_AUDIO_SOURCE@ toggle"}), { locked = true })
    hl.bind("XF86AudioPlay", hl.dsp.exec_cmd(${lua "${exe pkgs.playerctl} play-pause"}), { locked = true })
    hl.bind("XF86AudioPause", hl.dsp.exec_cmd(${lua "${exe pkgs.playerctl} play-pause"}), { locked = true })
    hl.bind("XF86AudioNext", hl.dsp.exec_cmd(${lua "${exe pkgs.playerctl} next"}), { locked = true })
    hl.bind("XF86AudioPrev", hl.dsp.exec_cmd(${lua "${exe pkgs.playerctl} previous"}), { locked = true })
  '';

  waybarCss = ''
    * {
      font-family: "${font}", "${theme.fonts.mono.name}", sans-serif;
      font-size: 13px;
      border: none;
      border-radius: 0;
      min-height: 0;
    }

    window#waybar {
      background: ${p.mantle};
      color: ${p.text};
    }

    #workspaces button {
      padding: 0 8px;
      color: ${p.subtext0};
      background: transparent;
    }

    #workspaces button.active {
      color: ${p.crust};
      background: ${accent};
    }

    #workspaces button.urgent {
      color: ${p.crust};
      background: ${p.red};
    }

    #window,
    #clock,
    #tray,
    #pulseaudio,
    #bluetooth,
    #network {
      padding: 0 10px;
    }

    #pulseaudio.muted,
    #network.disconnected {
      color: ${p.red};
    }
  '';
in
lib.mkIf desktop.enable {
  wayland.windowManager.hyprland = {
    enable = true;
    # Hyprland and its portal come from the NixOS module.
    package = null;
    portalPackage = null;
    configType = "lua";
    # Starts hyprland-session.target (bound to graphical-session.target), so
    # user services like udiskie run here too.
    systemd.enable = true;
    extraConfig = luaConfig;
  };

  # Fail the build, not the login, if Hyprland rejects the config.
  xdg.configFile."hypr/hyprland.lua".source = lib.mkForce (
    pkgs.runCommand "hyprland-config-verified"
      {
        text = config.xdg.configFile."hypr/hyprland.lua".text;
        passAsFile = [ "text" ];
      }
      ''
        export HOME="$TMPDIR" XDG_RUNTIME_DIR="$TMPDIR"
        # Hyprland picks the config format (Lua or hyprlang) from the extension.
        cp "$textPath" "$TMPDIR/hyprland.lua"
        ${lib.getExe' hyprland "Hyprland"} --verify-config --config "$TMPDIR/hyprland.lua"
        cp "$TMPDIR/hyprland.lua" $out
      ''
  );

  programs.waybar = {
    enable = true;
    # Started by Hyprland itself, so it never runs in the niri session.
    systemd.enable = false;
    style = waybarCss;
    settings.main = {
      layer = "top";
      position = "top";
      height = 30;
      modules-left = [
        "hyprland/workspaces"
        "hyprland/window"
      ];
      modules-center = [ "clock" ];
      modules-right = [
        "tray"
        "pulseaudio"
        "bluetooth"
        "network"
      ];
      "hyprland/window" = {
        max-length = 60;
        separate-outputs = true;
      };
      clock = {
        format = "{:%a %d %b  %H:%M}";
        tooltip-format = "<tt>{calendar}</tt>";
      };
      tray.spacing = 8;
      pulseaudio = {
        format = "VOL {volume}%";
        format-muted = "MUTED";
        on-click = exe pkgs.pavucontrol;
      };
      bluetooth = {
        format = "BT {status}";
        format-connected = "BT {device_alias}";
        on-click = lib.getExe' pkgs.blueman "blueman-manager";
      };
      network = {
        format-ethernet = "LAN";
        format-wifi = "WIFI {essid}";
        format-disconnected = "OFFLINE";
        tooltip-format = "{ifname} {ipaddr}";
        on-click = lib.getExe' pkgs.networkmanagerapplet "nm-connection-editor";
      };
    };
  };

  programs.fuzzel = {
    enable = true;
    settings = {
      main = {
        font = "${font}:size=${toString (theme.fonts.size + 1)}";
        terminal = terminal;
        icon-theme = theme.icons.name;
        width = 40;
      };
      colors = lib.mapAttrs (_: c: "${bare c}ff") {
        background = p.base;
        text = p.text;
        prompt = p.subtext1;
        placeholder = p.overlay1;
        input = p.text;
        match = accent;
        selection = p.surface1;
        selection-text = p.text;
        selection-match = accent;
        counter = p.overlay1;
        border = accent;
      };
      border = {
        width = 2;
        radius = 8;
      };
    };
  };

  # mako reads this file. It is started by Hyprland (see autostart above)
  # rather than through Home Manager's services.mako, which would also make it
  # D-Bus activatable and let it race DMS for notifications in niri.
  xdg.configFile."mako/config".text = ''
    font=${font} ${toString theme.fonts.size}
    background-color=${p.base}
    text-color=${p.text}
    border-color=${accent}
    border-size=2
    border-radius=8
    default-timeout=5000

    [urgency=high]
    border-color=${p.peach}
    default-timeout=0
  '';

  programs.hyprlock = {
    enable = true;
    # Installed (with its PAM service) by the NixOS module.
    package = null;
    settings = {
      general.hide_cursor = true;
      background = [
        {
          path = "${theme.wallpaper}";
          blur_passes = 2;
        }
      ];
      label = [
        {
          text = "$TIME";
          font_family = font;
          font_size = 64;
          color = "rgb(${bare p.text})";
          position = "0, 80";
          halign = "center";
          valign = "center";
        }
      ];
      input-field = [
        {
          size = "300, 50";
          outline_thickness = 2;
          outer_color = "rgb(${bare accent})";
          inner_color = "rgb(${bare p.base})";
          font_color = "rgb(${bare p.text})";
          check_color = "rgb(${bare p.green})";
          fail_color = "rgb(${bare p.red})";
          placeholder_text = "Password";
          position = "0, -80";
          halign = "center";
          valign = "center";
        }
      ];
    };
  };
}
